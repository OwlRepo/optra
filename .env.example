# Local Docker host ports. Bumped off the legacy optra-prod/tyvera defaults
# (3100/3101) and Suki's 3000/3001 dev ports to avoid clashing with other
# locally-running stacks.
OPTRA_WEB_PORT=3300
OPTRA_API_PORT=3301

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/optra

# Redis
REDIS_HOST=localhost
# 6380, not 6379: docker-compose.yml publishes "6380:6379", so 6379 is the
# port INSIDE the container. Host-side runs (tests, the seeder) need 6380.
REDIS_PORT=6380
CHAT_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.95
CHAT_RATE_LIMIT_PER_MIN_PER_USER=20
CHAT_RATE_LIMIT_PER_MIN_PER_WORKSPACE=200
MAX_TOKENS_PER_WORKSPACE_MONTH=5000000

# S3-compatible object storage (SeaweedFS locally)
S3_ENDPOINT=http://localhost:8433
S3_REGION=us-east-1
# Local SeaweedFS only. This is the single `optra` identity in
# docker/seaweedfs/s3.json, which is the source of truth for the pair; the api
# service in docker-compose.yml carries the same one. Not secrets: they unlock
# nothing but the throwaway local object store. Production uses a gitignored
# docker/seaweedfs/s3.prod.json generated on the VPS by
# scripts/ensure-seaweedfs-s3-config.sh from the VPS .env.
S3_ACCESS_KEY=4ec7af4df6681cc7c51dfd44b372e353f68094e868c835f0
S3_SECRET_KEY=abf9c738cb378408b18ff4c392c23b2cb4df9b516b5596adf6cc6234ab62335f0277d578f5a5acc0d22a6c4d55053ab4
S3_BUCKET=optra-documents
S3_FORCE_PATH_STYLE=true

# --- Production only: Backblaze B2 ------------------------------------------
# Production does NOT use SeaweedFS. It reads and writes a private B2 bucket,
# set in the VPS's own .env and never in this file. Development and CI stay on
# SeaweedFS deliberately: the storage round-trip test keeps exercising a real
# S3 implementation with no credentials to manage, and production stays the
# only thing that moved.
#
# StorageService is S3-compatible either way, so this is configuration, not
# code — which is also what keeps it reversible.
#
#   S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com   # https:// matters; B2 shows it bare
#   S3_REGION=us-east-005                                # the region embedded in the endpoint
#   S3_BUCKET=optra-prod-objects
#   S3_ACCESS_KEY=<keyID of the optra-objects application key>
#   S3_SECRET_KEY=<applicationKey for the same key>
#   S3_FORCE_PATH_STYLE=false                            # B2 documents virtual-hosted style
#
# The key is scoped to that one bucket. That is safe here because
# StorageService#ensureBucket does a HeadBucket and returns as soon as the
# bucket exists, so it never attempts the CreateBucket a scoped key is refused.
#
# Bytes are still served THROUGH the API rather than by presigned URL. That is
# deliberate: presigning would hand the response to B2 along with the
# `Content-Disposition: attachment`, hard-coded `application/octet-stream` and
# `X-Content-Type-Options: nosniff` that keep uploaded bytes safe on our own
# origin. See docs/ai/risk-register.md, "Serving Uploaded Bytes Back".

# OpenAI
OPENAI_API_KEY=sk-your-key-here
# Per-task chat models. Each falls back to OPENAI_CHAT_MODEL, then gpt-4-turbo.
# Answering is quality-critical (keep it strong); rewrite/grade/extraction are
# cheap classification-style calls and can use a faster/cheaper model.
OPENAI_CHAT_MODEL=gpt-4-turbo
OPENAI_ANSWER_MODEL=gpt-4-turbo
OPENAI_REWRITE_MODEL=gpt-4o-mini
OPENAI_GRADE_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
OPENAI_CONDENSE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Procurement PDF extraction (A2). Text path always tried first; scanned/
# image-only PDFs fall back to vision (gpt-4o + rasterized pages via
# pdfjs-dist/@napi-rs/canvas, both permissively licensed — see
# docs/ai/risk-register.md for the mupdf/AGPL evaluation and why it was
# swapped out before any code depended on it).
OPENAI_PROCUREMENT_EXTRACTION_MODEL=gpt-4o
PROCUREMENT_PDF_EXTRACTION_ENABLED=true
# S8 auto-orchestration. When true, a document that finishes parsing enqueues a
# comparison for every pair it could have changed the answer for. Default off:
# a comparison run is permanent evidence, and POLICY v1 #9's retention guard
# then refuses to hard-delete any document that run referenced — so the first
# deploy of something that writes runs on its own should not also be the first
# time anyone watches it behave. The manual Compare button works either way.
PROCUREMENT_AUTO_COMPARE_ENABLED=false
PROCUREMENT_PDF_MAX_PAGES=10

# Vendor catalog ingestion + vision matching (A3). Reuses
# OPENAI_PROCUREMENT_EXTRACTION_MODEL above — no separate model var.
CATALOG_ENABLED=true
CATALOG_MATCH_MAX_CANDIDATES=8
# Max candidate vision-comparisons in flight per catalog-match search (S0c).
CATALOG_MATCH_CONCURRENCY=3
CATALOG_IMAGE_MAX_BYTES=5242880

# LangSmith (optional)
LANGSMITH_API_KEY=ls__your-key-here
LANGSMITH_PROJECT=optra
RAGAS_JUDGE_MODEL=gpt-4-turbo

# Max tokens of retrieved context packed into the answer prompt (compact evidence
# pack: highest-scored chunks first, excerpts trimmed to fit). Lower = faster/cheaper.
RAG_CONTEXT_TOKEN_BUDGET=1500

# History-aware chat: condense follow-ups into standalone questions using recent
# session history (fixes retrieval/cache/classification for pronoun-style
# follow-ups like "find more like that"), and thread bounded recent history into
# the final answer prompt for conversational continuity. Both skip entirely
# (zero added cost) when a session has no prior history. Two independent flags
# so either can be rolled back without touching the other.
HISTORY_CONDENSE_ENABLED=true
HISTORY_IN_ANSWER_ENABLED=true
HISTORY_MAX_MESSAGES=12
HISTORY_TOKEN_BUDGET=600

# Simple lookups ("what is X?") retrieve at most this many chunks and skip the
# heavy graph (rewrite/grade). Complex/procedural queries use the full flow.
SIMPLE_QUERY_CHUNK_LIMIT=3

# Conditional LangGraph RAG
LANGGRAPH_ENABLED=false
RETRIEVAL_SCORE_THRESHOLD=0.78
MAX_QUERY_REWRITES=2
SELF_GRADE_ENABLED=false
# When self-grade is on, only grade answers whose top retrieval score is BELOW
# this value (low-confidence). Confident answers skip the extra grade/regenerate
# LLM calls. Leave unset to grade every answer (legacy behavior).
SELF_GRADE_MIN_SCORE=0.85

# Next.js Public URLs
NEXT_PUBLIC_API_URL=http://localhost:3301

# Auth (read by apps/api auth module + jwt strategy)
JWT_SECRET=change-me-in-prod
JWT_EXPIRY=15m

# Email OTP via Resend. EMAIL_OTP_ENABLED=false -> OTP prints to API console as "[DEV OTP] <email> -> <code>"
EMAIL_OTP_ENABLED=false
RESEND_API_KEY=re_your-key-here
RESEND_FROM_EMAIL=noreply@optra.com

# Backend URL used by Next.js server-side proxy routes (apps/web/app/api/*)
API_URL=http://localhost:3301

# Public web app URL — used to build workspace invite links.
WEB_URL=http://localhost:3300

# Scrape quota + crawler identification
MAX_DOCS_PER_WORKSPACE=5000
CRAWLER_USER_AGENT=OptraBot/1.0 (+https://optra.com/bot)
MAX_UPLOAD_MB=25

# Production only (not needed for local dev)
# DOMAIN=your-domain.com
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=secure-password
# POSTGRES_DB=optra
# Optional bundled Caddy ingress. Leave unset on shared VPS hosts where another
# service already owns ports 80/443.
# COMPOSE_PROFILES=public
