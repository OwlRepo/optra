# Production no longer runs SeaweedFS (B2 since 2026-09-25), but the VPS
# checkout still holds this generated file. Keep it ignored: the deploy stashes
# any untracked file, and an un-ignored one would be stashed on every deploy.
docker/seaweedfs/s3.prod.json

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Turbo
.turbo

# TypeScript incremental build metadata
*.tsbuildinfo
**/*.tsbuildinfo

