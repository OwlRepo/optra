.DS_Store
*.pem

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Testing
coverage

# Python tooling caches
__pycache__/
*.py[cod]

# Stray compiled output committed inside src/ instead of dist/ (happened once — see docs/ai/file-index/repository-map.md)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
apps/*/src/**/*.js
apps/*/src/**/*.js.map
.gstack/

# Claude Code hook acknowledgment files (per-turn state, never committed)
.claude/.predict-verify-ack
.claude/.plan-ack

# Seeder stock-image byte cache (re-downloadable from Pexels)
scripts/seed/.image-cache/

# Nested git repository dropped into the worktree - not part of this project.
# Staging it would record a gitlink, not files. Excluded rather than committed.
autonomous-engineering-md-package/
