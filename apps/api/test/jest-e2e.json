{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": [
    "<rootDir>/jest-e2e.setup.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "@swc/jest"
  },
  "moduleNameMapper": {
    "^@repo/(ai|db|types)$": "<rootDir>/../../../packages/$1/dist"
  },
  "testTimeout": 30000,
  "globalTeardown": "<rootDir>/jest-e2e.teardown.ts"
}
