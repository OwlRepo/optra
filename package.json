{
  "name": "optra",
  "private": true,
  "packageManager": "bun@1.2.22",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:seed": "bun run scripts/seed/index.ts",
    "db:seed:test": "bunx vitest run scripts/seed",
    "e2e": "turbo run build --filter=@repo/api --filter=@repo/web && bun run --cwd apps/e2e test:e2e",
    "docker:dev:up": "docker compose up -d",
    "docker:dev:build": "docker compose -f docker-compose.yml build",
    "docker:dev:down": "docker compose down",
    "docker:dev:logs": "docker compose logs -f",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "docker compose -f docker-compose.prod.yml up -d --remove-orphans",
    "deploy": "./scripts/deploy.sh",
    "deploy:remote": "./scripts/deploy-remote.sh"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^8",
    "eslint-config-next": "^14",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@types/node": "^26.0.1"
  }
}
